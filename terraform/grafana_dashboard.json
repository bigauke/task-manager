{
  "title": "Task Manager - Observability",
  "tags": ["task-manager"],
  "timezone": "browser",
  "panels": [
    {
      "title": "CPU Usage (task-manager)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{namespace=\"app\", container=\"task-manager\"}[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Memory Usage (task-manager)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{namespace=\"app\", container=\"task-manager\"}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Application Logs",
      "type": "logs",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 10 },
      "datasource": "Loki",
      "targets": [
        {
          "expr": "{app=\"task-manager\"}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 16,
  "version": 0,
  "refresh": "5s"
}
